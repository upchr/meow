#!/bin/bash
# 升级后：数据目录结构保持不变（app 载荷在 target 被整体替换，var 保留）。
set -u
mkdir -p "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/plugins" "$TRIM_PKGVAR/logs" "$TRIM_PKGVAR/run" 2>/dev/null
# 新载荷的 config/ 是真实目录，先换回符号链接再启动，否则插件会往 APPDEST 里写
"$(dirname "$0")/plugins_setup" >/dev/null 2>&1
# 升级会把载荷整目录换掉、根图标也可能被包里的静态图重置 → 再换回动画图标
# （fndesk 就是漏了这一步：它 upgrade_callback 只有 exit 0，升级后扫光会消失）
"$(dirname "$0")/icon_setup" >/dev/null 2>&1
# 分享目录权限同理：升级/重装后重新保证一次（root 才有权限）
"$(dirname "$0")/log_share_setup" >/dev/null 2>&1

# 老用户的 meow.conf 里没有 MEOW_TRUST_PROXY（1.2.19 及更早）：补上。
# 缺它时后端把所有人都当成 127.0.0.1 —— 限流、设备 lastIp/bindIp、媒体票
# IP 绑定全部失效，也判不出"局域网 vs 公网"的密码可用范围。
CONF="$TRIM_PKGETC/meow.conf"
if [ -f "$CONF" ] && ! grep -q 'MEOW_TRUST_PROXY' "$CONF" 2>/dev/null; then
    printf '\n# 由 meowd 按 socket 对端覆盖注入 X-Forwarded-For，可信\nexport MEOW_TRUST_PROXY=1\n' >> "$CONF" 2>/dev/null
fi

"$(dirname "$0")/main" start >/dev/null 2>&1
exit 0
