#!/bin/bash
# 运行控制：start | stop | status
# status 退出码：0=运行中，3=未运行（官方契约）
set -u

PIDFILE="$TRIM_PKGVAR/run/meowd.pid"
LOG="$TRIM_PKGVAR/logs/meowd.log"
CONF="$TRIM_PKGETC/meow.conf"

[ -f "$CONF" ] && . "$CONF" 2>/dev/null

# 向导值优先（安装/配置时由 fnOS 注入同名环境变量）
PORT="${wizard_port:-${MEOW_SHELL_PORT:-${TRIM_SERVICE_PORT:-30010}}}"
API_PORT="${wizard_api_port:-${MEOW_API_PORT:-30011}}"
# ★ 默认只监听回环：30010 一旦对 0.0.0.0 开放，就等于绕过 fnOS 统一网关。
#   网关身份头（X-Trim-*）在 TCP 入口被 meowd 主动剥掉（见
#   meowd/src/http.rs 的 set_peer_addr），所以直连 30010 的人拿不到身份，
#   只能走 meow 自己的鉴权。要局域网直连（TV 远程、手机）必须显式：
#     MEOW_SHELL_BIND=0.0.0.0  +  MEOW_AUTH_MODE=on
BIND="${MEOW_SHELL_BIND:-127.0.0.1}"

# ── 日志：用户可见的那份 + 启动前裁剪 ─────────────────────────────────────
# 用户看得到的那份在 @appshare/<app>/logs（目录由 cmd/log_share_setup 以 root 建，
# 因为 @appshare/<app> 本身是 root 000，package 账号写不进去）。这里只做**硬链**：
# 同卷不占双份空间，应用挂了也只是"用户那边看不见"，不影响自己写日志。
LOG_MAX_MB="${MEOW_LOG_MAX_MB:-4}"
LOG_KEEP_LINES="${MEOW_LOG_KEEP_LINES:-2000}"

share_logs_dir() {
    vol="${TRIM_APPDEST_VOL:-}"
    if [ -z "$vol" ] && [ -n "${TRIM_APPDEST:-}" ]; then
        vol="$(printf '%s' "$TRIM_APPDEST" | sed -n 's#^\(/vol[0-9][0-9]*\)/.*#\1#p')"
    fi
    [ -n "$vol" ] || return 1
    d="$vol/@appshare/${TRIM_APPNAME:-meow}/logs"
    [ -d "$d" ] && [ -w "$d" ] || return 1
    printf '%s' "$d"
}

# 启动前裁一次。★ 必须在 meowd（及其拉起的 Java）打开文件之前跑：
# sed -i 会换 inode，运行中裁等于把这期间写进旧 inode 的日志全丢掉。
trim_logs() {
    [ -d "$TRIM_PKGVAR/logs" ] || return 0
    max=$((LOG_MAX_MB * 1048576))
    keep_next=$((LOG_KEEP_LINES + 1))
    for f in "$TRIM_PKGVAR/logs"/*.log; do
        [ -f "$f" ] || continue
        sz="$(stat -c%s "$f" 2>/dev/null || echo 0)"
        [ "$sz" -gt "$max" ] || continue
        sed -i -e :a -e "\$q;N;${keep_next},\$D;ba" "$f" 2>/dev/null
    done
}

# 硬链到分享目录并放开读权限；api.log 要等 meowd 起来才有，所以放在启动之后调
link_logs() {
    d="$(share_logs_dir)" || return 0
    for f in "$TRIM_PKGVAR/logs"/*.log; do
        [ -f "$f" ] || continue
        ln -f "$f" "$d/$(basename "$f")" 2>/dev/null
        chmod 0644 "$f" 2>/dev/null
    done
}

running() {
    [ -f "$PIDFILE" ] || return 1
    p="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "${p:-}" ] || return 1
    kill -0 "$p" 2>/dev/null
}

# 期望版本：TRIM_APPVER 在 start 场景可能为空，退回包内 bin/VERSION；
# 都拿不到时输出空串，调用方按"只收养、不杀"处理。
expected_version() {
    if [ -n "${TRIM_APPVER:-}" ]; then
        printf '%s' "$TRIM_APPVER"
        return 0
    fi
    if [ -n "${TRIM_APPDEST:-}" ] && [ -f "$TRIM_APPDEST/bin/VERSION" ]; then
        tr -d '[:space:]' < "$TRIM_APPDEST/bin/VERSION"
    fi
}

# 端口上是不是本应用的 meowd？成功输出 "pid version"，否则返回 1。
# 用于发现「pid 文件丢了/被覆盖成死 PID，但进程其实还活着」的脱管实例。
probe_shell() {
    if command -v curl >/dev/null 2>&1; then
        out="$(curl -fsS -m 2 "http://127.0.0.1:$PORT/api/_shell/info" 2>/dev/null)" || return 1
    elif command -v wget >/dev/null 2>&1; then
        out="$(wget -q -T 2 -O - "http://127.0.0.1:$PORT/api/_shell/info" 2>/dev/null)" || return 1
    else
        return 1
    fi
    case "$out" in
        *'"app":"meow"'*'"role":"shell"'*) ;;
        *) return 1 ;;
    esac
    p="$(printf '%s' "$out" | sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' | head -1)"
    v="$(printf '%s' "$out" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$p" ] || return 1
    printf '%s %s\n' "$p" "$v"
}

# 只认「本安装的 meowd」：exe 是 meowd（QEMU 模拟下 exe 是 qemu 本体，改看 cmdline
# 里的 /bin/meowd），且 cmdline 的端口/data 都对得上。端口被别的应用占用时绝不误杀。
is_our_meowd() {
    [ -n "${1:-}" ] || return 1
    [ -d "/proc/$1" ] || return 1
    exe="$(readlink "/proc/$1/exe" 2>/dev/null || true)"
    cmd="$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)"
    case "$exe" in
        */meowd) ;;
        *)
            case "$cmd" in
                *"/bin/meowd "*|*"/bin/meowd") ;;
                *) return 1 ;;
            esac
            ;;
    esac
    case "$cmd" in
        *"--port=$PORT"*) ;;
        *) return 1 ;;
    esac
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        case "$cmd" in
            *"--data=$TRIM_PKGVAR/data"*) ;;
            *) return 1 ;;
        esac
    fi
    return 0
}

# meowd 被强杀后，它的 Java 在独立进程组里可能变成孤儿占着 API 端口；
# 按 cmdline 精确匹配后收掉，避免新后端起不来。
stop_leftover_api() {
    command -v ss >/dev/null 2>&1 || return 0
    line="$(ss -lntp 2>/dev/null | grep -F ":$API_PORT " | head -1)"
    [ -n "$line" ] || return 0
    p="$(printf '%s' "$line" | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -1)"
    [ -n "$p" ] || return 0
    cmd="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null || true)"
    case "$cmd" in *ApiServer*) ;; *) return 0 ;; esac
    case "$cmd" in *"--port=$API_PORT"*) ;; *) return 0 ;; esac
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        case "$cmd" in *"--data-dir=$TRIM_PKGVAR/data"*) ;; *) return 0 ;; esac
    fi
    kill -TERM "$p" 2>/dev/null
    i=0
    while [ "$i" -lt 20 ]; do
        kill -0 "$p" 2>/dev/null || break
        sleep 0.25
        i=$((i + 1))
    done
    kill -KILL "$p" 2>/dev/null
    sleep 0.3
}

case "${1:-}" in
start)
    mkdir -p "$TRIM_PKGVAR/run" "$TRIM_PKGVAR/logs" "$TRIM_PKGVAR/data" 2>/dev/null
    if running; then
        link_logs
        exit 0
    fi

    # pid 文件缺失/指向死 PID，但端口上其实还有本应用的 meowd（手工启动、或上一轮
    # stop 没杀干净）：同版本补写 pid 文件收养；旧版本先停掉再起新的。
    # 不处理的话新实例会 bind 失败退出，应用中心表现就是"启动一下又停用"。
    if info="$(probe_shell)"; then
        p="${info%% *}"
        v="${info#* }"
        if is_our_meowd "$p"; then
            want="$(expected_version)"
            if [ -z "$want" ] || [ "$v" = "$want" ]; then
                printf '%s' "$p" > "$PIDFILE"
                link_logs
                exit 0
            fi
            kill -TERM "$p" 2>/dev/null
            i=0
            while [ "$i" -lt 40 ]; do
                kill -0 "$p" 2>/dev/null || break
                sleep 0.25
                i=$((i + 1))
            done
            kill -KILL "$p" 2>/dev/null
            stop_leftover_api
        fi
    fi

    # ★ 裁剪只能放在这里：上面所有"已停"的分支都走完了，此刻 meowd 与它拉起的 Java
    #   都没打开日志文件；sed -i 换 inode 才不会把正在写的内容丢掉。
    trim_logs

    rm -f "$PIDFILE"

    # 对外监听范围与鉴权是否匹配：不匹配只告警、不阻断（用户可能故意这么配）
    if [ "$BIND" != "127.0.0.1" ] && [ "$BIND" != "::1" ]; then
        if [ "${MEOW_AUTH_MODE:-}" = "on" ]; then
            printf '[%s] [info] MEOW_SHELL_BIND=%s 对局域网开放，鉴权已开（账号密码/设备令牌）\n' \
                "$(date '+%F %T')" "$BIND" >>"$LOG" 2>/dev/null
        else
            printf '[%s] [warn] MEOW_SHELL_BIND=%s 对局域网开放，但 MEOW_AUTH_MODE 未开：同网段任何人都能读写你的配置与收藏（fnOS 网关身份在 TCP 入口已被剥离，帮不上忙）\n' \
                "$(date '+%F %T')" "$BIND" >>"$LOG" 2>/dev/null
        fi
    fi

    # meowd 自己会写 pid 文件并 setsid 脱离本脚本会话
    nohup "$TRIM_APPDEST/bin/meowd" \
        --port="$PORT" \
        --api-port="$API_PORT" \
        --bind="$BIND" \
        --api-bind=127.0.0.1 \
        --data="$TRIM_PKGVAR/data" \
        >>"$LOG" 2>&1 </dev/null &

    i=0
    while [ "$i" -lt 30 ]; do
        [ -f "$PIDFILE" ] && break
        sleep 0.2
        i=$((i + 1))
    done

    # 这时 api.log 已由 meowd 建好，一并链进分享目录
    link_logs

    # 起不来也不返回 1：应用中心会把非 0 当成安装/启动失败，掩盖真实原因
    if ! running; then
        echo "猫窝 Meow 未能启动，请查看共享目录 @appshare/${TRIM_APPNAME:-meow}/logs/（或应用目录下 var/logs/），端口 $PORT。" \
            > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null
    fi
    exit 0
    ;;
stop)
    if ! running; then
        rm -f "$PIDFILE"
        exit 0
    fi
    p="$(cat "$PIDFILE")"
    kill -TERM "$p" 2>/dev/null
    i=0
    while [ "$i" -lt 50 ]; do
        kill -0 "$p" 2>/dev/null || break
        sleep 0.2
        i=$((i + 1))
    done
    if kill -0 "$p" 2>/dev/null; then
        kill -KILL "$p" 2>/dev/null
    fi
    rm -f "$PIDFILE"
    exit 0
    ;;
status)
    running && exit 0
    exit 3
    ;;
*)
    exit 1
    ;;
esac
