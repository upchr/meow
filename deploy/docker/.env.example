# 复制为 .env 后按需修改。这是 docker compose 的变量覆盖层。
#
# 默认值都在 docker-compose.yml 的 ${VAR:-默认} 里，本文件只放要改的项。
# 全部注释 = 完全用默认值，也能正常运行。查看生效值：docker compose config
#
# 两组变量，别搞混：
#   A 组 只在宿主生效，不进容器（端口、绑定地址、镜像 tag）
#   B 组 会被传进容器（容器里的程序能读到）

# ── A 组：宿主侧 ────────────────────────────────────────
# 主版本（web + apiserver 一起走这条线）
MEOW_VERSION=1.2.8
# drpy 运行时的 tag。**独立版本线，不要跟 MEOW_VERSION 走**：
# drpy 只在主版本发版时顺带重打一次，中间的主版本号在远端不存在，
# 跟着走会让新机器 `docker compose up` 报 manifest unknown。
DRPY_VERSION=0.9.23
# 浏览器访问端口
WEB_PORT=30010

# 后端对宿主的绑定地址与端口
# 要给 TV / 局域网直连改成 0.0.0.0（注意 /api/proxy/stream 会转发任意 URL）
APISERVER_BIND=127.0.0.1
APISERVER_PORT=30011

# 弹幕服务绑定地址与端口（自带 Web UI）
DANMU_BIND=127.0.0.1
DANMU_API_PORT=30012

# 弹幕服务镜像（官方镜像，不从本仓库构建）
DANMU_API_IMAGE=logvar/danmu-api:1.21.6

# 直接用已发布的镜像（跳过本地构建）。
# 留空 = 用默认的 chrplus/meow-web、chrplus/meow-apiserver（含 amd64 + arm64）。
# 想用自己的镜像就填全名。
# WEB_IMAGE=chrplus/meow-web:0.8.0
# APISERVER_IMAGE=chrplus/meow-apiserver:0.8.0


# ── B 组：容器内 ────────────────────────────────────────
# web 容器：nginx 的 /api 反代目标
# 连外部后端时改为绝对地址，例如 http://192.168.1.10:30011
MEOW_APISERVER=http://apiserver:9979

# apiserver 容器：弹幕聚合服务地址
# 必须用服务名（容器里的 127.0.0.1 指向容器自己）
# 不启动 danmu_api 时置空写成 MEOW_DANMU_API= ，否则每次弹幕请求会先等一次超时才降级
MEOW_DANMAKU_API=http://danmu_api:9321

# apiserver 容器：写操作令牌
#
# 保护的是**改状态**的端点：收藏/进度/历史、配置导入、片库（含删文件）、
# 离线缓存清理、源停用与健康重置、转码任务。GET/搜索/播放**不受影响**。
#
# 什么时候需要设：后端不是只监听本机时。典型是把本机当家庭共享后端，
# 同一 WiFi 下任何人都能访问 30011 —— 不设令牌，别人能清空你的收藏、
# 删你的缓存、通过片库删 NAS 文件。
#
# 留空（默认）= 关闭鉴权。只监听 127.0.0.1 的单机自用不需要设。
#
# 设了之后：前端「设置 → 连接 → 写操作令牌」填同一个值。
# 忘了令牌的救法：改这里重启，或用 `docker exec` 改 /data/policy.json。
#
# 读取优先级：本变量 > policy.json 的 authToken（两处都空才关闭）。
# 生效判据：curl 后端 /api/health 看 "authRequired" 与 "authSource"。
MEOW_AUTH_TOKEN=

# ── CORS 来源策略（一般不用改）─────────────────────────────────────────────
# 默认 * = 不限制来源。内网、Tailscale / ZeroTier 组网、frp / Cloudflare 反代
# 都能直接开箱用（实测过 Tailscale 的 100.x 是 CGNAT 段，曾被旧版硬编码网段拦掉）。
#
#   *            → 任意来源（默认，推荐）
#   none         → 只放行本机 / TV 壳 / 桌面壳，其余全拦
#   a.com,b.com  → 只放行这些 Origin；公网暴露时写**完整** Origin（含协议与端口），
#                  例如 https://meow.example.com 或 http://1.2.3.4:30010
#
# 注意 CORS 只防"浏览器里的第三方页面"，不防直连。真正的访问控制靠
# 网络边界（防火墙 / 只绑内网）与上面的 MEOW_AUTH_TOKEN。
MEOW_CORS=*

# danmu_api 容器：弹幕来源顺序（不配只有 3 个来源）
DANMU_SOURCE_ORDER=douban,360,renren,hanjutv,iqiyi,tencent,youku,bilibili

# apiserver 容器：JVM 参数
APISERVER_JAVA_OPTS=-Xms64m -Xmx512m -Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8

# ── 源服务（独立 sources yml / 全部服务 yml）──────────────────────────────
# 主 docker-compose.yml / build.yml 不含 sources。
#   docker-compose.with-sources.yml  主栈 + sources
#   docker-compose.sources.yml       只启动 sources
# 镜像内置主爬虫 + Jable 扩展 + 41 站默认配置；不挂载也能用。
# 要换成自己的完整源包时，设置 MEOW_SOURCES_DIR（只读挂载到 /mounted-sources）。
# MEOW_SOURCES_BASE 是内置源生成 jar 绝对地址用的；给 TV/Fongmi 时必须填
# 电视能访问到的局域网/公网地址，不能填 127.0.0.1。
MEOW_SOURCES_IMAGE=chrplus/meow-sources:1.2.0
MEOW_SOURCES_BASE=http://127.0.0.1:18080
MEOW_SOURCES_PORT=18080
MEOW_SOURCES_BIND=0.0.0.0
# MEOW_SOURCES_DIR=./sources
